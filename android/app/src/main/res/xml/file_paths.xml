<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider paths for the in-app updater (AppUpdatePlugin):
     the downloaded APK lives in the app's external files directory,
     the cache dir is allowed as a fallback download target. -->
<paths>
    <external-files-path name="updates" path="." />
    <cache-path name="cache" path="." />
</paths>
