// 真机和模拟器的 arm64 指令集相同，Mach-O 平台不同，不能共用静态库。
FQAPI_CORE_LIBRARY[sdk=iphoneos*] = $(SRCROOT)/Frameworks/iphoneos/libfqapi_core.a
FQAPI_CORE_LIBRARY[sdk=iphonesimulator*] = $(SRCROOT)/Frameworks/iphonesimulator/libfqapi_core.a
ARCHS[sdk=iphonesimulator*] = $(NATIVE_ARCH_ACTUAL)

// FRB 和媒体入口通过 process()/dlsym 查找，保留并导出静态库符号。
OTHER_LDFLAGS = $(inherited) -force_load $(FQAPI_CORE_LIBRARY) -framework Security -framework CoreFoundation -Wl,-export_dynamic -liconv
DEAD_CODE_STRIPPING = NO
STRIP_INSTALLED_PRODUCT = NO
